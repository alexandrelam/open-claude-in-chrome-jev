{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "chrome"],
    // Tests index into fixtures they just built, and a wrong guess fails the
    // test anyway. Everything else stays as strict as the source.
    "noUncheckedIndexedAccess": false
  },
  "include": ["**/*.ts", "../extension/types/*.d.ts"]
}
